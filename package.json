{
  "name": "arcflow",
  "private": true,
  "version": "0.1.0",
  "description": "ArcFlow: synergic CAD/CAM for CNC plasma cutters (F2100K, GRBL)",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @arcflow/desktop dev",
    "tauri": "pnpm --filter @arcflow/desktop tauri",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "golden:update": "UPDATE_GOLDEN=1 vitest run packages/post"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
