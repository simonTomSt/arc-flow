{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArcFlow",
  "version": "0.1.0",
  "identifier": "pl.ksbd.arcflow",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ArcFlow",
        "width": 1600,
        "height": 1000,
        "minWidth": 1200,
        "minHeight": 760,
        "backgroundColor": "#111113"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "fileAssociations": [{ "ext": ["arcflow"], "name": "ArcFlow project", "role": "Editor" }]
  }
}
